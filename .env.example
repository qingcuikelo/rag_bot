# ============================================================
# 星驰科技 RAG 智能客服 · 环境变量样例
# 复制为 .env 后按需修改；切勿将真实密钥提交到仓库。
# 对应文档：docs/RAG系统开发文档.md §12.2 配置契约
#
# 注意：注释请单独成行，勿写在值后面（否则可能被解析为值）。
#       留空（KEY=）表示使用默认值。
# ============================================================

# ---------- LLM ----------
# openai | ollama | llamacpp
LLM_PROVIDER=
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
# API 失败时的降级目标
LLM_FALLBACK=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
LLAMACPP_MODEL_PATH=

# ---------- Embedding / Rerank ----------
# openai | ollama
EMBED_PROVIDER=
EMBED_MODEL=
# 部分供应商限制单批 embedding 数量（阿里云为 20）
EMBED_BATCH_SIZE=
RERANK_MODEL=

# ---------- 检索参数 ----------
RETRIEVE_K=
BM25_K=
RERANK_TOP_N=
RRF_C=

# ---------- 判据（§12.5）----------
GRADE_SCORE_THRESHOLD=
CHECK_RETRY_MAX=

# ---------- 存储路径 ----------
CHROMA_PATH=
SQLITE_PATH=
CHECKPOINT_PATH=

# ---------- 可观测（LangSmith）----------
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

# ---------- 鉴权（§12.7）----------
AUTH_ENABLED=
JWT_SECRET=
JWT_TTL_MINUTES=
SERVICE_API_KEY=
# PII 哈希加盐（客户手机号等）；生产环境务必改为随机值
PII_SALT=

# ---------- 运行时 ----------
HUMAN_HANDOFF_ENABLED=
REQUEST_TIMEOUT_S=
LOG_LEVEL=
